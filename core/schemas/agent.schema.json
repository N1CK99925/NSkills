{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nskills.local/schemas/agent.schema.json",
  "title": "NSkills agent frontmatter",
  "type": "object",
  "required": [
    "name",
    "description",
    "version",
    "license",
    "compatibility",
    "mode",
    "tools",
    "delegates",
    "metadata"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "license": { "type": "string", "minLength": 1 },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["opencode", "hermes", "freebuff", "generic"] }
    },
    "mode": { "enum": ["primary", "subagent"] },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["read", "search", "edit", "shell", "delegate", "web", "ask-human", "load-skill", "track"]
      }
    },
    "delegates": {
      "oneOf": [
        { "enum": ["none", "same-kind"] },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "metadata": {
      "type": "object",
      "required": ["nskills"],
      "properties": {
        "nskills": {
          "type": "object",
          "required": ["tags", "provenance"],
          "properties": {
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
            },
            "provenance": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
