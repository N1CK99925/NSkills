{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nskills.local/schemas/skill.schema.json",
  "title": "NSkills skill frontmatter",
  "type": "object",
  "required": ["name", "description", "version", "license", "compatibility", "metadata"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "license": { "type": "string", "minLength": 1 },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["opencode", "hermes", "freebuff", "generic"] }
    },
    "user-invocable": { "type": "boolean" },
    "paths": { "type": "array", "items": { "type": "string" } },
    "depends": {
      "type": "object",
      "properties": {
        "skills": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "agents": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["nskills"],
      "properties": {
        "nskills": {
          "type": "object",
          "required": ["tags", "provenance"],
          "properties": {
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
            },
            "provenance": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
